-- SCROLL
-- ══════════════════════════════════════════════════════════════════
do
    function UILib:_GetSec(sdid)
        if not self._sec_scroll[sdid] then self._sec_scroll[sdid]={offset=0,target=0,maxScroll=0} end
        return self._sec_scroll[sdid]
    end
    function UILib:_TickScroll(sdid,dt)
        local s=self:_GetSec(sdid)
        s.offset=lerp(s.offset,s.target,dlp(0.12,dt))
        if math.abs(s.offset-s.target)<0.5 then s.offset=s.target end
        return s.offset
    end
    function UILib:_ScrollSection(sdid,delta)
        local s=self:_GetSec(sdid); s.target=clamp(s.target+delta,0,s.maxScroll)
    end
    function UILib:_DrawScrollbar(sdid,ox,oy,cw,ch,totalH,offset,zBase)
        if totalH<=ch then return end
        local SBW=3; local P=3
        local trackH=ch-P*2
        local thumbH=math.max(20,trackH*(ch/totalH))
        local thumbY=oy+P+(trackH-thumbH)*(offset/math.max(1,totalH-ch))
        local sbX=ox+cw-SBW-2
        self:_Draw(sdid..'_sb_track','rect',self._theming.border0,zBase,Vector2.new(sbX,oy+P),Vector2.new(SBW,trackH),true,SBW/2); self:_SetOpacity(sdid..'_sb_track',0.35)
        self:_Draw(sdid..'_sb_thumb','rect',self._theming.subtext,zBase+1,Vector2.new(sbX,thumbY),Vector2.new(SBW,thumbH),true,SBW/2); self:_SetOpacity(sdid..'_sb_thumb',0.7)
    end
    function UILib:_UndrawScrollbar(sdid)
        self:_Undraw(sdid..'_sb_track'); self:_Undraw(sdid..'_sb_thumb')
    end
end

