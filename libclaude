-- CONFIG SYSTEM
-- ══════════════════════════════════════════════════════════════════
do
    local function _hasFsApi() return type(writefile)=='function' and type(readfile)=='function' end
    local function _mkfolder(path) if type(makefolder)=='function' then pcall(makefolder,path) end end
    local function _isfile(path) if type(isfile)=='function' then local ok,v=pcall(isfile,path); return ok and v end return false end
    local function _write(path,data) if type(writefile)=='function' then pcall(writefile,path,data) end end
    local function _read(path) if type(readfile)=='function' then local ok,v=pcall(readfile,path); if ok then return v end end return nil end
    local function _listfiles(path) if type(listfiles)=='function' then local ok,v=pcall(listfiles,path); if ok and type(v)=='table' then return v end end return {} end
    local function jsonEncode(t) local hs=game:GetService('HttpService'); local ok,r=pcall(function() return hs:JSONEncode(t) end); return ok and r or nil end
    local function jsonDecode(s) local hs=game:GetService('HttpService'); local ok,r=pcall(function() return hs:JSONDecode(s) end); return ok and r or nil end

    function UILib:_RegisterConfigRef(tN,sN,id,item)
        table.insert(self._config_refs,{tab=tN,sec=sN,idx=id,item=item})
    end

    function UILib:_BuildConfigData()
        local data={}
        for _,ref in ipairs(self._config_refs) do
            local key=ref.tab..'/'..ref.sec..'/'..tostring(ref.idx)
            local item=ref.item
            if item.type_=='toggle' then data[key]=item.value
            elseif item.type_=='slider' then data[key]=item.value
            elseif item.type_=='dropdown' then data[key]=type(item.value)=='table' and table.concat(item.value,',') or tostring(item.value or '')
            elseif item.type_=='textbox' then data[key]=item.value or '' end
            if item.keybind then data[key..'__kb']=item.keybind.value or ''; data[key..'__kbmode']=item.keybind.mode or 'Toggle' end
        end
        data['__theme']=self._theme_name
        data['__menukey']=self._menu_key
        return data
    end

    function UILib:_ApplyConfigData(data)
        if type(data)~='table' then return end
        for _,ref in ipairs(self._config_refs) do
            local key=ref.tab..'/'..ref.sec..'/'..tostring(ref.idx)
            local item=ref.item; local v=data[key]
            if v~=nil then
                if item.type_=='toggle' then
                    item.value=(v==true or v=='true')
                    if item.callback then pcall(item.callback,item.value) end
                    local ak=ref.tab..ref.sec..tostring(ref.idx)
                    self._toggle_anim[ak]=item.value and 1 or 0
                elseif item.type_=='slider' then
                    local n=tonumber(v); if n then item.value=n; if item.callback then pcall(item.callback,n) end end
                elseif item.type_=='dropdown' then
                    local parts={}; for p in tostring(v):gmatch('[^,]+') do table.insert(parts,p) end
                    item.value=parts; if item.callback then pcall(item.callback,item.value) end
                elseif item.type_=='textbox' then
                    item.value=tostring(v); if item.callback then pcall(item.callback,item.value) end
                end
            end
            if item.keybind then
                local kbv=data[key..'__kb']; local kbm=data[key..'__kbmode']
                if kbv~=nil then item.keybind.value=tostring(kbv) end
                if kbm~=nil then item.keybind.mode=tostring(kbm) end
            end
        end
        if data['__theme'] and self._themes[data['__theme']] then self:_ApplyTheme(data['__theme']) end
        if data['__menukey'] and self._inputs[data['__menukey']] then self._menu_key=data['__menukey'] end
        for _,cb in ipairs(self._config_callbacks) do pcall(cb,data) end
    end

    function UILib:_AutoSaveTick(dt)
        if not self._autosave_dirty then return end
        self._autosave_timer=self._autosave_timer+dt
        if self._autosave_timer>=self._autosave_delay then
            self._autosave_dirty=false
            self._autosave_timer=0
            -- Silent save to _last — no notification
            if not _hasFsApi() then return end
            _mkfolder(self._config_folder)
            local data=self:_BuildConfigData()
            local json=jsonEncode(data); if not json then return end
            _write(self._config_folder..'/_last.json',json)
        end
    end

    function UILib:_RefreshConfigList()
        local names=self:ListConfigs()
        local filtered={}
        local hasDefault=false
        for _,n in ipairs(names) do
            if n~='_last' then
                table.insert(filtered,n)
                if n=='default' then hasDefault=true end
            end
        end
        -- Always show 'default' as an option even if file doesn't exist yet
        if not hasDefault then table.insert(filtered,1,'default') end
        self._config_list=filtered
        return filtered
    end

    function UILib:SaveConfig(name)
        name=tostring(name or self._config_name or 'default')
        if not _hasFsApi() then self:Notification('No filesystem API',5); return end
        _mkfolder(self._config_folder)
        local data=self:_BuildConfigData()
        local json=jsonEncode(data)
        if not json then self:Notification('Encode failed',4); return end
        _write(self._config_folder..'/'..name..'.json',json)
        self._config_name=name
        self:_RefreshConfigList()
        self:Notification('Saved: '..name,4)
    end

    function UILib:LoadConfig(name)
        name=tostring(name or self._config_name or 'default')
        if not _hasFsApi() then self:Notification('No filesystem API',5); return end
        local path=self._config_folder..'/'..name..'.json'
        if not _isfile(path) then self:Notification('Not found: '..name,4); return end
        local raw=_read(path)
        if not raw then self:Notification('Read failed',4); return end
        local data=jsonDecode(raw)
        if not data then self:Notification('Parse failed',4); return end
        self:_ApplyConfigData(data)
        if name~='_last' then self._config_name=name end
        self:_RefreshConfigList()
        if name~='_last' then self:Notification('Loaded: '..name,4) end
    end

    function UILib:DeleteConfig(name)
        name=tostring(name or self._config_name or 'default')
        if not _hasFsApi() then return end
        local path=self._config_folder..'/'..name..'.json'
        if type(delfile)=='function' then pcall(delfile,path) end
        self:_RefreshConfigList()
        self:Notification('Deleted: '..name,4)
    end

    function UILib:ListConfigs()
        if not _hasFsApi() then return {} end
        _mkfolder(self._config_folder)
        local files=_listfiles(self._config_folder); local names={}
        for _,f in ipairs(files) do local n=f:match('([^/\\]+)%.json$'); if n then table.insert(names,n) end end
        return names
    end

    function UILib:_MarkDirty()
        self._autosave_dirty=true
        self._autosave_timer=0
    end

    function UILib:AutoLoadConfig()
        if not _hasFsApi() then return end
        -- Create default config if it doesn't exist yet
        local defPath=self._config_folder..'/default.json'
        if not _isfile(defPath) then
            _mkfolder(self._config_folder)
            local data=self:_BuildConfigData()
            local json=jsonEncode(data)
            if json then _write(defPath,json) end
        end
        local lastPath=self._config_folder..'/_last.json'
        if _isfile(lastPath) then self:LoadConfig('_last'); return end
        if _isfile(defPath) then self:LoadConfig('default') end
    end

    function UILib:OnConfigLoaded(cb)
        if type(cb)=='function' then table.insert(self._config_callbacks,cb) end
    end
end

