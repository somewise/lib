local RunService = game:GetService('RunService')
local Players    = game:GetService('Players')
local workspace  = workspace
local lp         = Players.LocalPlayer

local FONT      = Drawing.Fonts.SystemBold
local FONT_SIZE = 13
local MAX_DIST  = 250
local CAM_MAX   = 50
local BATTERY_R = 4
local SCAN_HZ   = 0.5

local ELEC_COLOR        = Color3.fromRGB(80, 180, 255)
local DEF_COLOR         = Color3.fromRGB(80, 200, 255)
local DEF_PLANTED_COLOR = Color3.fromRGB(255, 50, 50)

-- Fuzzy match dictionary to catch clones (e.g. "NeedleMine 2", "Toxic_Charge(Clone)")
local ITEM_DEFS = {
    ['bomb']               = {'Bomb',               Color3.fromRGB(255, 80, 80)},
    ['breachcharge']       = {'Breach Charge',      Color3.fromRGB(255, 160, 50)},
    ['hardbreach']         = {'Hard Breach',        Color3.fromRGB(255, 130, 30)},
    ['needlemine']         = {'Needle Mine',        Color3.fromRGB(200, 100, 255)},
    ['claymore']           = {'Claymore',           Color3.fromRGB(255, 80, 80)},
    ['toxiccharge']        = {'Toxic Charge',       Color3.fromRGB(80, 220, 120)},
    ['toxicgas']           = {'Toxic Charge',       Color3.fromRGB(80, 220, 120)},
    ['remotec4']           = {'Remote C4',          Color3.fromRGB(255, 80, 80)},
    ['proximityalarm']     = {'Proximity Alarm',    Color3.fromRGB(200, 100, 255)},
    ['stickycamera']       = {'Sticky Camera',      Color3.fromRGB(255, 220, 60)},
    ['deployableshield']   = {'Deployable Shield',  Color3.fromRGB(160, 200, 255)},
    ['bulletproofcamera']  = {'Bulletproof Camera', Color3.fromRGB(255, 160, 50)},
    ['signaldisruptor']    = {'Signal Disruptor',   Color3.fromRGB(255, 220, 60)},
    ['thermitecharge']     = {'Thermite Charge',    Color3.fromRGB(255, 80, 80)},
    ['incendiarycan']      = {'Incendiary Can.',    Color3.fromRGB(255, 140, 40)},
}

local _teammateNames = {}
local _entries       = {}
local _smoothCache   = {}
local _pool          = {}
local _active        = {}

local _items, _bats, _wires, _defs, _drones = {}, {}, {}, {}, {}

local function rebuildTeammates()
    table.clear(_teammateNames)
    local myTeam = lp.Team
    if not myTeam then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Team == myTeam then
            _teammateNames[p.Name] = true
        end
    end
end

-- Extremely robust ownership resolution 
local function ownerIsFriendly(model)
    local so = model:FindFirstChild('StateObject')
    if not so then return false end -- No StateObject = Assume Enemy
    
    local ov = so:FindFirstChild('owner') or so:FindFirstChild('Owner')
    if not ov then return false end
    
    local val = ov.Value
    if not val then return false end

    -- Match Character explicitly bypassing missing executor methods
    if typeof(val) == "Instance" then
        if val == lp.Character then return true end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character == val then
                return (p.Name == lp.Name or _teammateNames[p.Name] == true)
            end
        end
        local ok, str = pcall(function() return val.Name end)
        if ok and type(str) == "string" then
            return (str == lp.Name or _teammateNames[str] == true)
        end
    elseif type(val) == "string" and val ~= "" then
        return (val == lp.Name or _teammateNames[val] == true)
    end
    
    return false
end

local function findPart(model)
    local root = model:FindFirstChild('Root') or model:FindFirstChild('HumanoidRootPart') or model:FindFirstChild('Part')
    if root and root:IsA('BasePart') then return root end
    for _, v in ipairs(model:GetChildren()) do
        if v:IsA('BasePart') or v:IsA('UnionOperation') then return v end
    end
    return nil
end

local function getLabelObj()
    local n = #_pool
    if n > 0 then
        local d = _pool[n]
        _pool[n] = nil
        return d
    end
    local d = Drawing.new('Text')
    d.Font = FONT
    d.Size = FONT_SIZE
    d.Outline = true
    d.Center = true
    d.Visible = false
    return d
end

local function releaseAll()
    for i = 1, #_active do
        local d = _active[i]
        d.Visible = false
        _pool[#_pool + 1] = d
    end
    table.clear(_active)
end

-- Background Scan (0.5s)
local function buildEntries()
    rebuildTeammates()
    table.clear(_entries)
    table.clear(_items)
    table.clear(_bats)
    table.clear(_wires)
    table.clear(_defs)
    table.clear(_drones)
    
    for _, c in ipairs(workspace:GetChildren()) do
        local n = string.lower(string.gsub(c.Name, "[%s_]", ""))
        if string.find(n, "drone", 1, true) then
            _drones[#_drones+1] = c
        elseif string.find(n, "defus", 1, true) then
            _defs[#_defs+1] = c
        elseif string.find(n, "shockbattery", 1, true) then
            _bats[#_bats+1] = c
        elseif string.find(n, "barbedwire", 1, true) then
            _wires[#_wires+1] = c
        else
            for key, def in pairs(ITEM_DEFS) do
                if string.find(n, key, 1, true) then
                    _items[#_items+1] = {model = c, config = def}
                    break
                end
            end
        end
    end

    local eIndex = 1
    local function addEntry(data)
        _entries[eIndex] = data
        eIndex = eIndex + 1
    end

    -- 1. Standard Items
    for i = 1, #_items do
        local m = _items[i].model
        local def = _items[i].config
        if not ownerIsFriendly(m) then
            local p = findPart(m)
            if p then
                local b = m:FindFirstChild('Breakable')
                addEntry({
                    model = m, part = p,
                    label = def[1], color = def[2],
                    destroyedVal = b and b:FindFirstChild('destroyed') or nil, 
                    maxDist = MAX_DIST
                })
            end
        end
    end

    -- 2. Shock Batteries & Barbed Wire logic
    local batteries = {}
    for i = 1, #_bats do
        local b = _bats[i]
        if not ownerIsFriendly(b) then
            local p = findPart(b)
            if p then
                local br = b:FindFirstChild('Breakable')
                batteries[#batteries + 1] = {
                    model = b, part = p, pos = p.Position, linked = false, 
                    dVal = br and br:FindFirstChild('destroyed') or nil
                }
            end
        end
    end

    for i = 1, #_wires do
        local w = _wires[i]
        if not ownerIsFriendly(w) then
            local p = findPart(w)
            if p then
                local wPos = p.Position
                local hasBat = false
                for j = 1, #batteries do
                    local bat = batteries[j]
                    if not bat.linked then
                        local dx, dy, dz = bat.pos.X - wPos.X, bat.pos.Y - wPos.Y, bat.pos.Z - wPos.Z
                        if math.sqrt(dx*dx + dy*dy + dz*dz) <= BATTERY_R then
                            bat.linked = true
                            hasBat = true
                            break
                        end
                    end
                end
                local br = w:FindFirstChild('Breakable')
                addEntry({
                    model = w, part = p,
                    label = 'Barbed Wire', color = Color3.fromRGB(200, 100, 255),
                    hasBattery = hasBat, 
                    destroyedVal = br and br:FindFirstChild('destroyed') or nil, 
                    maxDist = MAX_DIST
                })
            end
        end
    end

    for i = 1, #batteries do
        local bat = batteries[i]
        if not bat.linked then
            addEntry({
                model = bat.model, part = bat.part,
                label = 'Shock Battery', color = Color3.fromRGB(255, 240, 100),
                destroyedVal = bat.dVal, maxDist = MAX_DIST
            })
        end
    end

    -- 3. Defuser
    for i = 1, #_defs do
        local m = _defs[i]
        local p = findPart(m)
        if p then
            addEntry({
                model = m, part = p,
                isDefuser = true,
                plantedVal = m:FindFirstChild('Planted'),
                maxDist = MAX_DIST
            })
        end
    end

    -- 4. Drones
    for i = 1, #_drones do
        local m = _drones[i]
        if not ownerIsFriendly(m) then
            local p = findPart(m)
            if p then
                local hum = m:FindFirstChildOfClass('Humanoid') or m:FindFirstChild('Humanoid')
                addEntry({
                    model = m, part = p,
                    label = 'Drone', color = Color3.fromRGB(100, 200, 255),
                    isDrone = true, humanoidVal = hum, maxDist = MAX_DIST
                })
            end
        end
    end

    -- 5. Map Cameras
    local mapModel = workspace:FindFirstChild('Model')
    if mapModel then
        for _, folder in ipairs(mapModel:GetChildren()) do
            local defCams = folder:FindFirstChild('DefaultCameras')
            if defCams then
                for _, cam in ipairs(defCams:GetChildren()) do
                    if cam.Name == 'DefaultCamera' and not ownerIsFriendly(cam) then
                        local camPart = cam:FindFirstChild('Cam')
                        if camPart then
                            local b = camPart:FindFirstChild('Breakable')
                            addEntry({
                                model = cam, part = camPart,
                                label = 'Camera', color = Color3.fromRGB(200, 200, 200),
                                isCamera = true,
                                destroyedVal = b and b:FindFirstChild('destroyed') or nil, 
                                maxDist = CAM_MAX
                            })
                        end
                    end
                end
            end
        end
    end

    local newSmooth = {}
    for i = 1, #_entries do
        local m = _entries[i].model
        if _smoothCache[m] then
            newSmooth[m] = _smoothCache[m]
        end
    end
    _smoothCache = newSmooth
end

local _lastScan = 0

-- High Performance O(1) Render Loop
local _conn = RunService.RenderStepped:Connect(function(dt)
    local cam = workspace.CurrentCamera
    if not cam then releaseAll(); return end
    local camPos = cam.CFrame.Position

    local now = tick()
    if now - _lastScan >= SCAN_HZ then
        _lastScan = now
        buildEntries()
    end

    releaseAll()
    local n = #_entries

    dt = math.clamp(dt, 0.001, 0.1)
    local lerpAlpha = math.clamp(dt * 20, 0.05, 1)

    for i = 1, n do
        local e = _entries[i]
        local m = e.model
        local p = e.part
        
        if m.Parent and p.Parent then
            local valid = true
            
            -- Pre-cached validations skip heavy lookups entirely
            if e.destroyedVal and e.destroyedVal.Value == true then valid = false end
            
            local labelStr = e.label
            local colorVal = e.color

            if valid then
                if e.isDrone then
                    if e.humanoidVal and e.humanoidVal.Health <= 0 then valid = false end
                elseif e.isDefuser then
                    local planted = m:GetAttribute('Planted')
                    if not planted and e.plantedVal then planted = e.plantedVal.Value end
                    labelStr = planted and 'Defuser (Planted)' or 'Defuser'
                    colorVal = planted and DEF_PLANTED_COLOR or DEF_COLOR
                end
            end

            if valid then
                local rawPos = p.Position
                
                -- Fast interpolation for smooth rendering
                local prev = _smoothCache[m]
                local curPos = prev and prev:Lerp(rawPos, lerpAlpha) or rawPos
                _smoothCache[m] = curPos

                local dx = curPos.X - camPos.X
                local dy = curPos.Y - camPos.Y
                local dz = curPos.Z - camPos.Z
                local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
                
                if dist <= e.maxDist then
                    local sp, onScreen = WorldToScreen(curPos)
                    
                    if sp and onScreen then
                        local alpha = math.clamp(1 - (dist / e.maxDist) * 0.4, 0.4, 1)
                        
                        local d = getLabelObj()
                        d.Text = string.format("%s [%dm]", labelStr, math.floor(dist * 0.5) * 2)
                        d.Color = colorVal
                        d.Position = sp
                        d.Transparency = alpha
                        d.Visible = true
                        _active[#_active + 1] = d

                        if e.hasBattery then
                            local d2 = getLabelObj()
                            d2.Text = '[+Battery]'
                            d2.Color = ELEC_COLOR
                            d2.Size = 11
                            d2.Position = Vector2.new(sp.X, sp.Y + FONT_SIZE + 2)
                            d2.Transparency = alpha
                            d2.Visible = true
                            _active[#_active + 1] = d2
                        end
                    end
                end
            end
        end
    end
end)

_G.ESPDisconnect = function()
    _conn:Disconnect()
    releaseAll()
    for d in pairs(_pool) do d:Remove() end
    table.clear(_pool)
    table.clear(_active)
    table.clear(_entries)
    table.clear(_smoothCache)
    print("ESP unloaded gracefully")
end

print("Operation One | ESP Loaded")
