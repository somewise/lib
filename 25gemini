    function UILib:_GetTextBounds(text,fontFace,fontSize)
        text = text or ""
        fontFace=fontFace or self._font_face; fontSize=fontSize or self._font_size
        if fontFace==Drawing.Fonts.UI then return Vector2.new(#text*fontSize*0.53846,fontSize) end
        return Vector2.new(#text*fontSize*0.58,fontSize)
    end

    function UILib:_Draw(dt, dc, dz, dop, ...)
        local pType = dt == 'rect' and 'Square' or (dt == 'text' and 'Text' or (dt == 'circle' and 'Circle' or (dt == 'triangle' and 'Triangle' or 'Line')))

        if dt == 'gradient' then
            local dir, orig, sz = ...
            local colors = {select(4, ...)}
            local ns = #colors - 1
            local lod = 22
            for i = 1, ns do
                local cc, nc = colors[i], colors[i+1]
                local slx, sly = math.max(1, sz.x)/ns, math.max(1, sz.y)/ns
                for j = 1, lod do
                    local t2 = (j-1)/(lod-1)
                    local tc2 = Color3.new(lerp(cc.R,nc.R,t2), lerp(cc.G,nc.G,t2), lerp(cc.B,nc.B,t2))
                    local ta = lerp(cc.A or 1, nc.A or 1, t2) * dop
                    local sp, ss
                    if dir == 'horizontal' then
                        ss = Vector2.new(slx/lod, sz.y)
                        sp = Vector2.new(orig.x + (i-1)*slx + (j-1)*ss.x, orig.y)
                    elseif dir == 'vertical' then
                        ss = Vector2.new(sz.x, sly/lod)
                        sp = Vector2.new(orig.x, orig.y + (i-1)*sly + (j-1)*ss.y)
                    end
                    self:_Draw('rect', tc2, dz, ta, sp, ss, true)
                end
            end
            return
        end

        self._pIdx[pType] = self._pIdx[pType] + 1
        local idx = self._pIdx[pType]
        local d = self._pool[pType][idx]
        local s = self._pool_state[pType][idx]

        if not d then
            d = Drawing.new(pType)
            d.Visible = false
            self._pool[pType][idx] = d
            s = { Visible = false }
            self._pool_state[pType][idx] = s
        end

        if s.ZIndex ~= dz then d.ZIndex = dz; s.ZIndex = dz end
        if dc ~= nil and s.Color ~= dc then pcall(function() d.Color = dc end); s.Color = dc end
        local t_val = clamp(dop, 0, 1)
        if s.Transparency ~= t_val then pcall(function() d.Transparency = t_val end); s.Transparency = t_val end
        if s.Visible ~= true then d.Visible = true; s.Visible = true end

        if dt == 'rect' then
            local pos, sz, filled, corner = ...
            if s.Position ~= pos then d.Position = pos; s.Position = pos end
            if s.Size ~= sz then d.Size = sz; s.Size = sz end
            if s.Filled ~= filled then d.Filled = filled; s.Filled = filled end
            if corner and corner > 0 then
                if s.Corner ~= corner then pcall(function() d.Corner = corner end); s.Corner = corner end
            else
                if s.Corner ~= 0 then pcall(function() d.Corner = 0 end); s.Corner = 0 end
            end
        elseif dt == 'text' then
            local pos, content, outline, align, sz, face = ...
            local isCenter = (align == 'center')
            if s.Center ~= isCenter then d.Center = isCenter; s.Center = isCenter end
            if s.Position ~= pos then d.Position = pos; s.Position = pos end
            if s.Text ~= content then d.Text = content; s.Text = content end
            if s.Outline ~= outline then d.Outline = outline; s.Outline = outline end
            local fFace = face or self._font_face
            if s.Font ~= fFace then d.Font = fFace; s.Font = fFace end
            local fSz = sz or self._font_size
            if s.Size ~= fSz then d.Size = fSz; s.Size = fSz end
        elseif dt == 'triangle' then
            local f, a, b, c = ...
            if s.Filled ~= f then d.Filled = f; s.Filled = f end
            if s.PointA ~= a then d.PointA = a; s.PointA = a end
            if s.PointB ~= b then d.PointB = b; s.PointB = b end
            if s.PointC ~= c then d.PointC = c; s.PointC = c end
        elseif dt == 'circle' then
            local pos, r, filled = ...
            if s.Position ~= pos then d.Position = pos; s.Position = pos end
            if s.Radius ~= r then d.Radius = r; s.Radius = r end
            if s.Filled ~= filled then d.Filled = filled; s.Filled = filled end
        elseif dt == 'line' then
            local f, t, th = ...
            if s.From ~= f then d.From = f; s.From = f end
            if s.To ~= t then d.To = t; s.To = t end
            local thVal = th or 1
            if s.Thickness ~= thVal then d.Thickness = thVal; s.Thickness = thVal end
        end
    end

    function UILib:_FullWipe()
        for _, pList in pairs(self._pool or {}) do
            for _, d in ipairs(pList) do pcall(function() d.Visible = false; d:Remove() end) end
        end
        self._pool = { Square = {}, Text = {}, Triangle = {}, Circle = {}, Line = {} }
        self._pool_state = { Square = {}, Text = {}, Triangle = {}, Circle = {}, Line = {} }
    end
end

