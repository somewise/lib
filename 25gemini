    end

    function UILib:CreateSettingsTab(customName)
        local st=self:Tab(customName or 'Settings')
        local name=customName or 'Settings'
        self._tab_order = self._tab_order or {}
        for i,n in ipairs(self._tab_order) do
            if n==name then table.remove(self._tab_order,i); break end
        end
        table.insert(self._tab_order,name)

        local ms=st:Section('Menu')
        local mk=ms:Toggle('Menu Key',self._overwrite_menu_key,function(v) self._overwrite_menu_key=v end)
        mk:AddKeybind(self._menu_key,function(v) self._menu_key=self:_KeyIDToName(v) end)
        ms:Toggle('Watermark',true,function(v) self:SetWatermarkEnabled(v) end)
        ms:Toggle('Custom watermark',self._custom_title_enabled,function(v) self._custom_title_enabled=v end)

        ms:Textbox('Watermark text',self.title,function(v)
            local str=tostring(v); if #str>20 then str=str:sub(1,20) elseif #str<3 then str=str..string.rep(" ",3-#str) end
            self._custom_title=str
        end)
        ms:Button('Unload Script', false, function() self:Unload() end)

        local cs=st:Section('Config & Theme')
        local themeNames={}
        for n in pairs(self._themes or {}) do table.insert(themeNames,n) end
        table.sort(themeNames)
        cs:Dropdown('Theme',{self._theme_name},themeNames,false,false,function(v)
            if v and v[1] then self:_ApplyTheme(v[1]) end
        end)

        cs:Textbox('New config name','',function(v)
            if v and v~='' then self._config_name=v end
        end)

        self:_RefreshConfigList()
        local configChoices=self._config_list
        if #configChoices==0 then configChoices={'default'} end
        local configDrop=cs:Dropdown('Saved configs',{self._config_name},configChoices,false,false,function(v)
            if v and v[1] then self._config_name=v[1] end
        end)

        cs:Button('Save config',false,function()
            self:SaveConfig(self._config_name)
            local fresh=self:_RefreshConfigList()
            if #fresh==0 then fresh={'default'} end
            configDrop:UpdateChoices(fresh)
        end)
        cs:Button('Load config',false,function() self:LoadConfig(self._config_name) end)
        cs:Button('Delete config',false,function()
            self:DeleteConfig(self._config_name)
            local fresh=self:_RefreshConfigList()
            if #fresh==0 then fresh={'default'} end
            configDrop:UpdateChoices(fresh)
            self._config_name=fresh[1] or 'default'
        end)

        return st,ms,cs
    end
end

local function GetItemHeight(lib, sItem)
    local iType = sItem.type_
    if iType == 'toggle' then return lib._font_size + 2 + lib._padding
    elseif iType == 'slider' then local lsz = cachedTextBounds(lib, sItem.label); return lsz.y + 6 + 18 + lib._padding * 3
    elseif iType == 'dropdown' then local lsz = cachedTextBounds(lib, sItem.label); return lsz.y * 2 + lib._padding * 4
    elseif iType == 'button' then local lsz = cachedTextBounds(lib, sItem.label); return lsz.y + lib._padding * 3
    elseif iType == 'textbox' then return lib._font_size + lib._padding * 2
    end
    return 0
end

local function itemMatchesSearch(lib, sItem)
    if lib._search_query == "" then return true end
    return string.find(string.lower(sItem.label), string.lower(lib._search_query), 1, true) ~= nil
end

function UILib:Step()
    if self._unloaded then return end

    self._pIdx = { Square = 0, Text = 0, Triangle = 0, Circle = 0, Line = 0 }

    self._tree       = self._tree or {}
    self._tab_order  = self._tab_order or {}
    self._sec_scroll = self._sec_scroll or {}
    self._sec_slide  = self._sec_slide or {}
    self._inputs     = self._inputs or {}
    self._item_vis   = self._item_vis or {}
    self._tab_scroll = self._tab_scroll or {}
    self._frame_tooltip = nil

    local T=self._theming; local CR=self._corner; local PAD=self._padding
    local KB_W=self._KB_W

    local now=os.clock()
    local dt=math.min(now-self._last_step_time,0.05)
    if self._last_step_time==0 then dt=0.016 end
    self._last_step_time=now
    local function _dlp(base) return dlp(base,dt) end

    self:_PollMousePos()
    self:_AutoSaveTick(dt)

    local _UIS = game:GetService("UserInputService")
    local focused = false
    pcall(function() focused = _UIS:GetFocusedTextBox() ~= nil end)

    local rbxActive = true
    if type(isrbxactive) == 'function' then
        pcall(function() rbxActive = isrbxactive() end)
    end

    if not self._kcCache then
        self._kcCache = {}
        for kc, _ in pairs(self._inputs) do
            if kc == 'm1' then self._kcCache[kc] = Enum.UserInputType.MouseButton1
            elseif kc == 'm2' then self._kcCache[kc] = Enum.UserInputType.MouseButton2
            elseif kc == 'mb' then self._kcCache[kc] = Enum.UserInputType.MouseButton3
            else
                pcall(function() self._kcCache[kc] = Enum.KeyCode[kc:upper()] end)
            end
        end
    end

    for kc, id2 in pairs(self._inputs) do
        local hit = false
        
        if type(iskeypressed) == 'function' then
            pcall(function() hit = iskeypressed(id2.id) end)
        else
            local enumObj = self._kcCache[kc]
            if enumObj then
                local s, res = pcall(function()
                    if kc == 'm1' or kc == 'm2' or kc == 'mb' then return _UIS:IsMouseButtonPressed(enumObj)
                    else return _UIS:IsKeyDown(enumObj) end
                end)
                
                if not s then 
                    pcall(function()
                        if kc == 'm1' or kc == 'm2' or kc == 'mb' then hit = _UIS:IsMouseButtonPressed(enumObj.Value)
                        else hit = _UIS:IsKeyDown(enumObj.Value) end
                    end)
                else
                    hit = res
                end
            end
        end

        if not focused and rbxActive and hit then
            self._inputs[kc].click = (not id2.held and not id2.click)
            self._inputs[kc].held = true
        else
            self._inputs[kc].click = false
            self._inputs[kc].held = false
        end
    end

    local clickFrame  = self:_IsKeyPressed('m1')
    local mouseHeld   = self:_IsKeyHeld('m1')
    local ctxFrame    = self:_IsKeyPressed('m2')
    local mkStr = tostring(self._overwrite_menu_key and self._menu_key or 'f5'):lower()
    local menuKey = self:_IsKeyPressed(mkStr)
    local clickConsumed = false

    local syntheticThisFrame=false
    for kn,k in pairs(self._inputs) do
