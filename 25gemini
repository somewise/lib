do
    local function _hasFsApi() return type(writefile)=='function' and type(readfile)=='function' end
    local function _mkfolder(path) if type(makefolder)=='function' then pcall(makefolder,path) end end
    local function _isfile(path) if type(isfile)=='function' then local ok,v=pcall(isfile,path); return ok and v end return false end
    local function _write(path,data) if type(writefile)=='function' then pcall(writefile,path,data) end end
    local function _read(path) if type(readfile)=='function' then local ok,v=pcall(readfile,path); if ok then return v end end return nil end
    local function _listfiles(path) if type(listfiles)=='function' then local ok,v=pcall(listfiles,path); if ok and type(v)=='table' then return v end end return {} end
    local function jsonEncode(t) local hs=game:GetService('HttpService'); local ok,r=pcall(function() return hs:JSONEncode(t) end); return ok and r or nil end
    local function jsonDecode(s) local hs=game:GetService('HttpService'); local ok,r=pcall(function() return hs:JSONDecode(s) end); return ok and r or nil end

    function UILib:_RegisterConfigRef(tN,sN,item)
        self._config_refs = self._config_refs or {}
        table.insert(self._config_refs,{tab=tN,sec=sN,label=item.label,item=item})
    end

    local function colorToHex(c)
        if not c then return nil end
        return string.format('%02X%02X%02X', math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end
    local function hexToColor(h)
        if not h or #h < 6 then return nil end
        h = h:match('^#?(%x%x%x%x%x%x)$')
        if not h then return nil end
        return Color3.fromRGB(tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16))
    end
    function UILib:_BuildConfigData()
        local data={}
        for _,ref in ipairs(self._config_refs or {}) do
            local key=ref.tab..'/'..ref.sec..'/'..ref.label
            local item=ref.item
            if item.type_=='toggle' then data[key]=item.value
            elseif item.type_=='slider' then data[key]=item.value
            elseif item.type_=='dropdown' then data[key]=type(item.value)=='table' and table.concat(item.value,',') or tostring(item.value or '')
            elseif item.type_=='textbox' then data[key]=item.value or '' end
            if item.keybind then data[key..'__kb']=item.keybind.value or '' end
            if item.colorpicker then data[key..'__cp']=colorToHex(item.colorpicker.value) end
        end
        data['__theme']=self._theme_name
        data['__menukey']=self._menu_key
        return data
    end

    function UILib:_ApplyConfigData(data)
        if type(data)~='table' then return end
        for _,ref in ipairs(self._config_refs or {}) do
            local key=ref.tab..'/'..ref.sec..'/'..ref.label
            local item=ref.item; local v=data[key]
            local rawCb = item._rawcb
            if v~=nil then
                if item.type_=='toggle' then
                    item.value=(v==true or v=='true')
                    if rawCb then pcall(rawCb,item.value) end
                    local ak=ref.tab..ref.sec..ref.label
                    self._toggle_anim[ak]=item.value and 1 or 0
                elseif item.type_=='slider' then
                    local n=tonumber(v); if n then item.value=n; if rawCb then pcall(rawCb,n) end end
                elseif item.type_=='dropdown' then
                    local parts={}; for p in tostring(v):gmatch('[^,]+') do table.insert(parts,p) end
                    item.value=parts; if rawCb then pcall(rawCb,item.value) end
                elseif item.type_=='textbox' then
                    item.value=tostring(v); if rawCb then pcall(rawCb,item.value) end
                end
            end
            if item.keybind then
                local kbv=data[key..'__kb']
                if kbv~=nil then item.keybind.value=tostring(kbv) end
            end
            if item.colorpicker then
                local cpv=data[key..'__cp']
                if cpv then
                    local restored=hexToColor(tostring(cpv))
                    if restored then item.colorpicker.value=restored; if item.colorpicker.callback then pcall(item.colorpicker.callback,restored) end end
                end
            end
        end
        if data['__theme'] and self._themes[data['__theme']] then self:_ApplyTheme(data['__theme']) end
        if data['__menukey'] and self._inputs[data['__menukey']] then self._menu_key=data['__menukey'] end
        for _,cb in ipairs(self._config_callbacks or {}) do pcall(cb,data) end
    end

    function UILib:_AutoSaveTick(dt)
        if not self._autosave_dirty then return end
        self._autosave_timer = self._autosave_timer + safeNum(dt, 0.016)
        if self._autosave_timer < self._autosave_delay then return end
        self._autosave_dirty = false
        self._autosave_timer = 0
        self._autosave_last  = os.clock()
        if not _hasFsApi() then return end
        _mkfolder(self._config_folder)
        local data = self:_BuildConfigData()
        local json = jsonEncode(data)
        if not json then return end
        _write(self._config_folder..'/_last.json', json)
    end

    function UILib:_RefreshConfigList()
        local names=self:ListConfigs()
        local filtered={}
        local hasDefault=false
        for _,n in ipairs(names or {}) do
            if n~='_last' then
                table.insert(filtered,n)
                if n=='default' then hasDefault=true end
            end
        end
        if not hasDefault then table.insert(filtered,1,'default') end
        self._config_list=filtered
        return filtered
    end

    function UILib:SaveConfig(name)
        name=tostring(name or self._config_name or 'default')
        if name=='default' or name=='' then
            self:Notification('Set a config name first (Config & Theme → New config name)',5); return
        end
        if not _hasFsApi() then self:Notification('No filesystem API',5); return end
        _mkfolder(self._config_folder)
        local data=self:_BuildConfigData()
        local json=jsonEncode(data)
        if not json then self:Notification('Encode failed',4); return end
        _write(self._config_folder..'/'..name..'.json',json)
        self._config_name=name
        self:_RefreshConfigList()
        self:Notification('Saved: '..name,4)
    end

    function UILib:LoadConfig(name)
        name=tostring(name or self._config_name or 'default')
        if not _hasFsApi() then self:Notification('No filesystem API',5); return end
        local path=self._config_folder..'/'..name..'.json'
        if not _isfile(path) then self:Notification('Not found: '..name,4); return end
        local raw=_read(path)
        if not raw then self:Notification('Read failed',4); return end
        local data=jsonDecode(raw)
        if not data then self:Notification('Parse failed',4); return end
        self:_ApplyConfigData(data)
        if name~='_last' then self._config_name=name end
        self:_RefreshConfigList()
        if name~='_last' then self:Notification('Loaded: '..name,4) end
    end

    function UILib:DeleteConfig(name)
        name=tostring(name or self._config_name or 'default')
        if name=='default' then self:Notification('Cannot delete default config',4); return end
        if not _hasFsApi() then return end
        local path=self._config_folder..'/'..name..'.json'
        if type(delfile)=='function' then pcall(delfile,path) end
        self:_RefreshConfigList()
        self:Notification('Deleted: '..name,4)
    end

    function UILib:ListConfigs()
        if not _hasFsApi() then return {} end
        _mkfolder(self._config_folder)
        local files=_listfiles(self._config_folder); local names={}
        for _,f in ipairs(files or {}) do
            local norm=tostring(f):gsub('\\','/')
            local n=norm:match('([^/]+)%.json$')
            if n then table.insert(names,n) end
        end
        return names
    end

    function UILib:_MarkDirty()
        if not self._autosave_dirty then
            self._autosave_timer = 0
        end
        self._autosave_dirty = true
    end

    function UILib:AutoLoadConfig()
        if not _hasFsApi() then return end
        local defPath=self._config_folder..'/default.json'
        if not _isfile(defPath) then
            _mkfolder(self._config_folder)
            local data=self:_BuildConfigData()
            local json=jsonEncode(data)
            if json then _write(defPath,json) end
        end
        local lastPath=self._config_folder..'/_last.json'
        if _isfile(lastPath) then self:LoadConfig('_last'); return end
        if _isfile(defPath) then self:LoadConfig('default') end
    end
end

do
    function UILib:_GetSec(sdid)
        self._sec_scroll = self._sec_scroll or {}
        if not self._sec_scroll[sdid] then self._sec_scroll[sdid]={offset=0,target=0,maxScroll=0} end
        return self._sec_scroll[sdid]
    end
    function UILib:_TickScroll(sdid,dt)
        local s=self:_GetSec(sdid)
        s.offset=lerp(s.offset,s.target,dlp(0.12,dt))
        if math.abs(s.offset-s.target)<0.5 then s.offset=s.target end
        return s.offset
    end
    function UILib:_ScrollSection(sdid,delta)
        local s=self:_GetSec(sdid); s.target=clamp(s.target+delta,0,s.maxScroll)
    end
end

do
    function UILib:_KeyIDToName(id) for n,k in pairs(self._inputs or {}) do if k.id==id then return n end end return nil end
    function UILib:_IsKeyPressed(k) return self._inputs and self._inputs[k] and self._inputs[k].click end
    function UILib:_IsKeyHeld(k)    return self._inputs and self._inputs[k] and self._inputs[k].held end
    function UILib:_GetScreenSize()
        local now2=os.clock()
        if not self._cached_ss or now2-(self._cached_ss_at or 0)>1 then
            local ss=Vector2.new(1920,1080); local cam=workspace.CurrentCamera
            if cam and cam.ViewportSize then ss=cam.ViewportSize end
            self._cached_ss=ss; self._cached_ss_at=now2
        end
        return self._cached_ss
    end
    function UILib:_GetMousePos() return self._cached_mouse or Vector2.new() end
    function UILib:_PollMousePos()
        local lp=_Players.LocalPlayer
        if lp then
            local m=lp:GetMouse()
            if m then
                local mx,my=m.X,m.Y; local cm=self._cached_mouse
                if not cm or cm.x~=mx or cm.y~=my then self._cached_mouse=Vector2.new(mx,my) end
                return
            end
        end
        if not self._cached_mouse then self._cached_mouse=Vector2.new() end
    end
    function UILib:_IsMouseWithinBounds(o,s)
        local m=self:_GetMousePos()
        return m.x>=o.x and m.x<=o.x+s.x and m.y>=o.y and m.y<=o.y+s.y
    end
    function UILib:_ApplyTheme(name) self._theme_name=name; self._theming=self._themes[name] or self._themes.Light end
end

