                                            local actualLblSz = self:_GetTextBounds(sItem.label)
                                            local newTagPos = bOa + Vector2.new(bSza.x/2 + actualLblSz.x/2 + 8, (bSza.y - 14)/2)
                                            self:_Draw('rect', T.accent, 9, itemOp, newTagPos, Vector2.new(28, 14), true, 4)
                                            self:_Draw('text', T.surface0, 10, itemOp, newTagPos+Vector2.new(14, 7), 'NEW', false, 'center', 9)
                                        end

                                    -- ─────────────────────────────────────────────
                                    -- TEXTBOX
                                    -- ─────────────────────────────────────────────
                                    elseif iType == 'textbox' then
                                        local tbO  = siOrig; local tbSz = Vector2.new(secW - PAD*2, self._font_size + PAD)
                                        local hover    = not mouseBlocked and self:_IsMouseWithinBounds(tbO, tbSz)
                                        local isTyping = self._input_ctx == siid
                                        local cursor   = math.floor(os.clock()*2)%2 == 0 and '|' or ' '
                                        local hasVal   = iVal and iVal ~= ''
                                        
                                        local phKey    = siid..'_ph'
                                        self._toggle_anim[phKey] = lerp(self._toggle_anim[phKey] or (hasVal and 1 or 0), hasVal and 1 or 0, _dlp(0.18))
                                        local phAlpha  = self._toggle_anim[phKey]
                                        local dv = isTyping and ((iVal or '')..cursor) or (hasVal and iVal or sItem.label)..' '
                                        local vc = (isTyping or hover) and T.text or lerpC(T.subtext, T.text, phAlpha)

                                        if self:_GetTextBounds(dv).x > tbSz.x then
                                            for i = 1, #dv do local s2 = dv:sub(i); if self:_GetTextBounds(s2).x <= tbSz.x - 4 then dv = s2; break end end
                                        end
                                        local vsz = self:_GetTextBounds(dv)

                                        if self:_IsKeyPressed('m1') then
                                            if canClick and hover then
                                                self._input_ctx = siid
                                                self:_RemoveCtxMenu()
                                                clickFrame = false; clickConsumed = true
                                            elseif isTyping then
                                                self._input_ctx = nil; self:_RemoveDropdown(); isTyping = false
                                            end
                                        end

                                        if ctxFrame and interactable and hover then
                                            local mp = self:_GetMousePos()
                                            self:_SpawnCtxMenu(mp.x, mp.y, siid, sItem)
                                            ctxFrame = false
                                        end

                                        if isTyping then
                                            local cm = {space=' ', dash='-', colon=':', period='.', comma=',', slash='/', semicolon=';', quote='\'', leftbracket='[', rightbracket=']', backslash='\\', equals='=', minus='-'}
                                            local sm = {['1']='!', ['2']='@', ['3']='#', ['4']='$', ['5']='%', ['6']='^', ['7']='&', ['8']='*', ['9']='(', ['0']=')', ['-']='_', ['=']='+', ['[']='{', [']']='}', [';']=':', ['\'']='\"', [',']='<', ['.']='>', ['/']='?', ['\\']='|'}
                                            local nv = iVal or ''; local shift = self:_IsKeyHeld('lshift') or self:_IsKeyHeld('rshift')

                                            local held_char = nil
                                            for char in pairs(self._inputs or {}) do
                                                if self:_IsKeyHeld(char) then held_char = char; break end
                                            end

                                            if held_char then
                                                if not self._key_repeat[held_char] then
                                                    self._key_repeat[held_char] = os.clock() + 0.4
                                                elseif os.clock() > self._key_repeat[held_char] then
                                                    self._key_repeat[held_char] = os.clock() + 0.05
                                                    local mapped = cm[held_char] or held_char
                                                    if mapped == 'backspace' then
                                                        nv = nv:sub(1, -2)
                                                    elseif #mapped == 1 then
                                                        if shift and sm[mapped] then mapped = sm[mapped] elseif shift then mapped = mapped:upper() end
                                                        if #nv < 200 then nv = nv .. mapped end
                                                    end
                                                    if sItem.callback then sItem.callback(nv) end; sItem.value = nv
                                                end
                                            else
                                                self._key_repeat = {}
                                            end

                                            for char in pairs(self._inputs or {}) do
                                                if self:_IsKeyPressed(char) then
                                                    local mapped = cm[char] or char
                                                    if mapped == 'enter' or mapped == 'esc' then self._input_ctx = nil; break
                                                    elseif mapped == 'backspace' then
                                                        nv = nv:sub(1, -2)
                                                    elseif #mapped == 1 then
                                                        if shift and sm[mapped] then mapped = sm[mapped] elseif shift then mapped = mapped:upper() end
                                                        if #nv < 200 then nv = nv .. mapped end
                                                    end
                                                    if sItem.callback then sItem.callback(nv) end; sItem.value = nv
                                                end
                                            end
                                        end

                                        self:_Draw('rect', isTyping and T.surface0 or T.surface1, 7, itemOp, tbO, tbSz, true, 6)
                                        self:_Draw('rect', isTyping and T.accent or (hover and T.border0 or T.border1), 8, itemOp, tbO, tbSz, false, 6)
                                        self:_Draw('text', vc, 8, itemOp, tbO + Vector2.new(6, vsz.y/2 - 2), dv, false)
                                    end
                                end

                                sH = sH + current_iH
                            end
                        end

                        curY = curY + cardH + (sTsz.y/2 + PAD) * secAnim
                    end
                end
            end

            local secW = bcSize.x/2 - PAD*1.5
            renderColumn(leftHeights, false, bcPos.x + PAD)
            renderColumn(rightHeights, true, bcPos.x + PAD*2 + secW)
        end
    end

    -- ──────────────────────────────────────────────────────────────
    -- TEXTBOX CONTEXT MENU (Copy / Clear)
    -- ──────────────────────────────────────────────────────────────
    local ctx = self._ctx_menu
    if ctx then
        ctx._anim = lerp(ctx._anim or 0, 1, _dlp(0.30))
        local ctxA  = ctx._anim
        local itemH = self._font_size + 8
        local ctxW  = 80
        local ctxH  = #ctx.items * itemH + 4
        local ctxX  = ctx.x; local ctxY = ctx.y

        if ctxX + ctxW > wx + ww - 4 then ctxX = wx + ww - ctxW - 4 end
        if ctxY + ctxH > wy + wh - 4 then ctxY = ctxY - ctxH end

        local ctxPos = Vector2.new(ctxX, ctxY)
        local ctxSz  = Vector2.new(ctxW, ctxH)

        self:_Draw('rect', T.shadow, 700, 0.18*ctxA*winOp, ctxPos+Vector2.new(2,4), ctxSz, true, 6)
        self:_Draw('rect', T.surface0, 701, ctxA*winOp, ctxPos, ctxSz, true, 6)
        self:_Draw('rect', T.border1, 702, ctxA*winOp, ctxPos, ctxSz, false, 6)

        for i, item in ipairs(ctx.items) do
            local iY    = ctxY + 2 + (i-1)*itemH
            local iPos  = Vector2.new(ctxX+2, iY)
            local iSz   = Vector2.new(ctxW-4, itemH)
            local hover = self:_IsMouseWithinBounds(iPos, iSz)

            if hover then
                self:_Draw('rect', lerpC(T.surface0, T.accent, 0.18), 703, ctxA*winOp, iPos, iSz, true, 4)
            end
            self:_Draw('text', hover and T.text or T.subtext, 704, ctxA*winOp, iPos+Vector2.new(ctxW/2-2, itemH/2), item.label, false, 'center', 12)

            if hover and clickFrame and not clickConsumed then
                local sItem = ctx.sItem
                if item.action == 'copy' then
                    local val = sItem.value or ''
                    if type(setclipboard) == 'function' then pcall(setclipboard, val) end
                    self:Notification('Copied to clipboard', 2)
                elseif item.action == 'clear' then
                    sItem.value = ''
                    if sItem.callback then sItem.callback('') end
                    self:_MarkDirty()
                    self:Notification('Cleared', 2)
                end
                self:_RemoveCtxMenu()
                clickFrame = false; clickConsumed = true
            end
        end

        if (clickFrame or ctxFrame) and not clickConsumed and not self:_IsMouseWithinBounds(ctxPos, ctxSz) then
            self:_RemoveCtxMenu()
            clickFrame = false; ctxFrame = false; clickConsumed = true
        end
    end

    -- ──────────────────────────────────────────────────────────────
    -- DYNAMIC ROLL-DOWN DROPDOWN PANEL
    -- ──────────────────────────────────────────────────────────────
    local dd = self._active_dropdown
    if dd then
        dd._anim = lerp(dd._anim or 0, 1, _dlp(0.20))
        local ddA = dd._anim
        local ddO = dd.position
        local choiceH = self._font_size + 9
        local maxVisibleChoices = 6
        local totalChoices = #(dd.choices or {})
        local displayCount = math.min(totalChoices, maxVisibleChoices)
        local panelW = dd.width
        local targetPanelH = displayCount * choiceH + PAD
        
        local screenB = self:_GetScreenSize()
        local flipped = false
        if ddO.y + targetPanelH > screenB.y - 10 then 
            flipped = true
            ddO = Vector2.new(ddO.x, ddO.y - targetPanelH - (dd._srcH or 0)) 
        end

        local overflows = totalChoices > maxVisibleChoices
        local maxScroll = math.max(0, totalChoices * choiceH - (targetPanelH - PAD))

        if scrollDelta ~= 0 and self:_IsMouseWithinBounds(ddO, Vector2.new(panelW, targetPanelH)) then
            dd._scroll_target = clamp((dd._scroll_target or 0) - scrollDelta, 0, maxScroll)
        end
        dd._scroll_target = dd._scroll_target or 0
        dd._scroll_v = lerp(dd._scroll_v or 0, dd._scroll_target, _dlp(0.25))
        if math.abs(dd._scroll_v - dd._scroll_target) < 0.5 then dd._scroll_v = dd._scroll_target end

        local currentPanelH = math.max(1, targetPanelH * easeOut(ddA))
        local currentDdO = flipped and Vector2.new(ddO.x, ddO.y + (targetPanelH - currentPanelH)) or ddO

        self:_Draw('rect', T.shadow, 500, 0.15*winOp, currentDdO+Vector2.new(2,4), Vector2.new(panelW, currentPanelH), true, 6)
        self:_Draw('rect', T.surface0, 501, winOp, currentDdO, Vector2.new(panelW, currentPanelH), true, 6)
        self:_Draw('rect', T.border1, 502, winOp, currentDdO, Vector2.new(panelW, currentPanelH), false, 6)

        local ddTop = currentDdO.y
        local ddBot = currentDdO.y + currentPanelH

        local thumbH, sbX, trackH
        if overflows and currentPanelH > 20 then
            local SBW = 3
            sbX = panelW - SBW - 2
            trackH = currentPanelH - PAD
            thumbH = math.max(10, trackH * (trackH / (trackH + maxScroll)))

            if mouseHeld then
                if self:_IsMouseWithinBounds(currentDdO + Vector2.new(sbX - 5, PAD/2), Vector2.new(SBW + 10, trackH)) and clickFrame and not clickConsumed then
                    self._dd_drag = 'dd_sb'; clickFrame = false; clickConsumed = true
                end
                if self._dd_drag == 'dd_sb' then
                    local mp = self:_GetMousePos()
                    local pct = clamp((mp.y - (currentDdO.y + PAD/2) - thumbH/2) / math.max(1, trackH - thumbH), 0, 1)
                    dd._scroll_target = pct * maxScroll
                end
            else
                self._dd_drag = nil
            end

            local thumbY = PAD/2 + (trackH - thumbH) * (dd._scroll_v / maxScroll)
            self:_Draw('rect', T.border0, 503, 0.35 * winOp, currentDdO+Vector2.new(sbX,PAD/2), Vector2.new(3,trackH), true, 1.5)
            self:_Draw('rect', T.subtext, 504, 0.7 * winOp, currentDdO+Vector2.new(sbX,thumbY), Vector2.new(3,thumbH), true, 1.5)
        end

        for i, choice in ipairs(dd.choices or {}) do
            local absItemY = (flipped and ddO.y or ddO.y) + PAD/2 + (i-1)*choiceH - dd._scroll_v
            local itemBot = absItemY + choiceH
            
            if itemBot > ddTop and absItemY < ddBot then
                local edgeFade = 1.0
                local FADE_ZONE = 3
                local distTop = absItemY - ddTop
                local distBot = ddBot - itemBot
                if distTop < FADE_ZONE then edgeFade = math.max(0, distTop / FADE_ZONE) end
                if distBot < FADE_ZONE then edgeFade = math.min(edgeFade, math.max(0, distBot / FADE_ZONE)) end
                if distTop < 0 or distBot < 0 then edgeFade = 0 end

                if edgeFade > 0.05 then
                    local found = type(dd.value)=='table' and table.find(dd.value,choice) or false
                    local cO   = Vector2.new(ddO.x+6, absItemY)
                    local cSz  = Vector2.new(panelW-(overflows and 16 or 12), choiceH)
                    local interactable = (edgeFade > 0.4)
                    local hover = interactable and self:_IsMouseWithinBounds(cO, cSz)

                    if hover then
                        local hTop = math.max(cO.y+1, ddTop+2)
                        local hBot = math.min(cO.y+cSz.y-1, ddBot-2)
                        local hH   = math.max(0, hBot - hTop)
                        if hH > 0 then
                            self:_Draw('rect', lerpC(T.surface0,T.accent,0.18), 505, winOp*edgeFade, Vector2.new(cO.x+2, hTop), Vector2.new(cSz.x-4, hH), true, 4)
                        end
                    end

                    local cc = hover and T.text or (found and T.text or T.subtext)
                    self:_Draw('text', cc, 506, winOp*edgeFade, cO+Vector2.new(2,4), choice, false, nil, 12)

                    if hover and clickFrame and not clickConsumed then
                        if dd.multi then
                            if type(dd.value)~='table' then dd.value={} end
                            local fi=table.find(dd.value,choice)
                            if fi then table.remove(dd.value,fi) else table.insert(dd.value,choice) end
                        else dd.value={choice} end
                        if dd.callback then dd.callback(dd.value) end
                        if not dd.multi then self:_RemoveDropdown() end
                        clickFrame=false; clickConsumed=true; break
                    end
                end
            end
        end

        if clickFrame and not clickConsumed and not self:_IsMouseWithinBounds(currentDdO, Vector2.new(panelW, currentPanelH)) then 
            self:_RemoveDropdown(); self._active_dropdown_owner=nil; clickFrame=false; clickConsumed=true 
        end
    end

    -- ──────────────────────────────────────────────────────────────
    -- COLORPICKER
    -- ──────────────────────────────────────────────────────────────
    local cp=self._active_colorpicker
    if cp then
        cp._anim = lerp(cp._anim or 0, cp._closing and 0 or 1, _dlp(0.18))
        local cpf = cp._anim
        if cp._closing and cpf < 0.05 then
            self._active_colorpicker = nil
        else
            local shouldCancel=true
            local fullCpSz=Vector2.new(240,215); local cpO=cp.position
            local cpTsz=self:_GetTextBounds(cp.label)
            
            local currentCpSz = Vector2.new(fullCpSz.x, math.max(1, fullCpSz.y * easeOut(cpf)))

            self:_Draw('rect', T.shadow, 600, 0.18*winOp, cpO+Vector2.new(2,4), currentCpSz, true, CR)
            self:_Draw('rect', T.surface0, 601, winOp, cpO, currentCpSz, true, CR)
            self:_Draw('rect', T.border1, 602, winOp, cpO, currentCpSz, false, CR)
            
            if currentCpSz.y > 20 then
                self:_Draw('text', T.text, 603, winOp, cpO+Vector2.new(PAD,PAD+1), cp.label, false)
            end

            if currentCpSz.y > 40 then
                local curC=Color3.fromHSV(cp._h,cp._s,cp._v)
                local cpPrevSz = Vector2.new(24, 14)
                local cpPrevO  = cpO+Vector2.new(fullCpSz.x-PAD-cpPrevSz.x, PAD+1)
                self:_Draw('rect', T.border1, 603, winOp, cpPrevO, cpPrevSz, true, 4)
                self:_Draw('rect', curC, 604, winOp, cpPrevO+Vector2.new(1,1), cpPrevSz-Vector2.new(2,2), true, 4)
                
                local ppPos=cpO+Vector2.new(PAD,PAD+cpTsz.y+10); local ppSz=Vector2.new(fullCpSz.x-PAD*2, 100)
                self:_Draw('rect', T.border1, 602, winOp, ppPos, ppSz, false)
                self:_Draw('rect', T.body, 604, winOp, ppPos, ppSz, true)

                local mp2=self:_GetMousePos()
                local pSz=ppSz; local hSz=Vector2.new(pSz.x,14)
                local pPos=ppPos; local hPos=pPos+Vector2.new(0,pSz.y+10)
                local hexBarPos=hPos+Vector2.new(0,hSz.y+10)
                local hexSz = Vector2.new(pSz.x, 24)

                if self:_IsMouseWithinBounds(hPos,hSz) and mouseHeld then cp._h=clamp((mp2.x-hPos.x)/math.max(1,hSz.x),0,1); shouldCancel=false; if cp.callback then cp.callback(Color3.fromHSV(cp._h,cp._s,cp._v)) end end
                if self:_IsMouseWithinBounds(pPos,pSz) and mouseHeld then
                    cp._s=clamp((mp2.x-pPos.x)/math.max(1,pSz.x),0,1); cp._v=1-clamp((mp2.y-pPos.y)/math.max(1,pSz.y),0,1); shouldCancel=false; if cp.callback then cp.callback(Color3.fromHSV(cp._h,cp._s,cp._v)) end
                end

                local hueC=Color3.fromHSV(cp._h,1,1)
                self:_Draw('gradient', nil, 605, winOp, 'horizontal', pPos, pSz, Color3.fromRGB(255,255,255), hueC)
                self:_Draw('gradient', nil, 606, winOp, 'vertical', pPos, pSz, {R=0,G=0,B=0,A=0}, {R=0,G=0,B=0,A=1})
                self:_Draw('gradient', nil, 606, winOp, 'horizontal', hPos, hSz, Color3.fromRGB(255,0,0), Color3.fromRGB(255,255,0), Color3.fromRGB(0,255,0), Color3.fromRGB(0,255,255), Color3.fromRGB(0,0,255), Color3.fromRGB(255,0,255), Color3.fromRGB(255,0,0))

                local pickerCirclePos = pPos + Vector2.new(pSz.x * cp._s, pSz.y * (1 - cp._v))
                self:_Draw('circle', Color3.fromRGB(255,255,255), 607, 0.9 * winOp, pickerCirclePos, 5, false)

                local hueThumbX = hPos.x + hSz.x * cp._h
                self:_Draw('rect', Color3.fromRGB(255,255,255), 607, winOp, Vector2.new(hueThumbX - 2, hPos.y - 2), Vector2.new(4, hSz.y + 4), true)
                self:_Draw('rect', Color3.fromRGB(50,50,50), 608, winOp, Vector2.new(hueThumbX - 2, hPos.y - 2), Vector2.new(4, hSz.y + 4), false)

                local hexStr = '#'..string.format('%02X%02X%02X', math.floor(curC.R*255), math.floor(curC.G*255), math.floor(curC.B*255))
                self:_Draw('rect', T.surface1, 605, winOp, hexBarPos, hexSz, true, 4)
                self:_Draw('rect', T.border1, 606, winOp, hexBarPos, hexSz, false, 4)
                self:_Draw('text', T.text, 607, winOp, hexBarPos+Vector2.new(hexSz.x/2, hexSz.y/2), hexStr, false, 'center', 12)
            end

            if clickFrame and not clickConsumed and not self:_IsMouseWithinBounds(cpO, currentCpSz) then self:_RemoveColorpicker(); clickConsumed=true; clickFrame=false end
        end
    end

    -- ──────────────────────────────────────────────────────────────
    -- TOOLTIP
    -- ──────────────────────────────────────────────────────────────
    if self._frame_tooltip then
        if not self._tooltip or self._tooltip.key ~= self._frame_tooltip.key then
            self._tooltip = {key = self._frame_tooltip.key, text = self._frame_tooltip.text, timer = 0, _anim = 0}
        end
    else
        self._tooltip = nil
    end

    if self._tooltip then
        local tt=self._tooltip; tt.timer=(tt.timer or 0)+dt
        tt._anim = lerp(tt._anim or 0, tt.timer > 0.50 and 1 or 0, _dlp(0.28))
        local ttFade = easeOut(tt._anim)
        if ttFade > 0.01 then
            local ttTxtSz=self:_GetTextBounds(tt.text)
            local ttW=ttTxtSz.x+PAD*1.5; local ttH=ttTxtSz.y+PAD*0.8
            local mp=self:_GetMousePos(); local ttPos=Vector2.new(mp.x+10,mp.y-ttH-6)
            self:_Draw('rect', T.shadow, 999, 0.18*globalAlpha*ttFade, ttPos+Vector2.new(1,2), Vector2.new(ttW,ttH), true, 6)
            self:_Draw('rect', T.surface0, 1000, globalAlpha*ttFade, ttPos, Vector2.new(ttW,ttH), true, 6)
            self:_Draw('rect', T.border1, 1001, globalAlpha*ttFade, ttPos, Vector2.new(ttW,ttH), false, 6)
            self:_Draw('text', T.text, 1001, globalAlpha*ttFade, ttPos+Vector2.new(PAD*0.75,(ttH-self._font_size)/2+1), tt.text, false)
        end
    end

    -- Menu drag (topbar)
    if realClick and not clickConsumed and not self._menu_drag and self:_IsMouseWithinBounds(Vector2.new(wx, wy), Vector2.new(ww, TBAH)) then
        local mp = self._cached_mouse or Vector2.new(); self._menu_drag = Vector2.new(mp.x - self.x, mp.y - self.y)
    end

    -- Pool cleanup
    for pType, pool in pairs(self._pool or {}) do
        for i = (self._pIdx[pType] or 0) + 1, #pool do
            local obj = pool[i]
            local s = self._pool_state[pType][i]
            if s and s.Visible ~= false then
                pcall(function() obj.Visible = false end)
                s.Visible = false
            end
        end
    end
end

return UILib
