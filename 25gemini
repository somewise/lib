                                            self:_Draw('rect', T.accent, 8, itemOp, newTagPos, Vector2.new(28, 14), true, 4)
                                            self:_Draw('text', T.surface0, 9, itemOp, newTagPos+Vector2.new(14, 7), 'NEW', false, 'center', 9)
                                        end

                                    -- ─────────────────────────────────────────────
                                    -- BUTTON
                                    -- ─────────────────────────────────────────────
                                    elseif iType == 'button' then
                                        local itemCP = sItem.colorpicker
                                        local rightReserve = 0
                                        local btnInnerH = self:_GetTextBounds(sItem.label).y + PAD
                                        if itemCP then
                                            local cpSzEl = Vector2.new(24, 14)
                                            local cpOEl  = siOrig + Vector2.new(secW - PAD*2 - cpSzEl.x, (btnInnerH - cpSzEl.y)/2)
                                            rightReserve = cpSzEl.x + PAD*2
                                            local hover  = not mouseBlocked and self:_IsMouseWithinBounds(cpOEl, cpSzEl)
                                            self:_Draw('rect', T.border1, 7, itemOp, cpOEl, cpSzEl, true, 4)
                                            self:_Draw('rect', itemCP.value, 8, itemOp, cpOEl+Vector2.new(1,1), cpSzEl-Vector2.new(2,2), true, 4)
                                            if hover and canClick then self:_SpawnColorpicker(nil, itemCP.label, itemCP.value, function(nv) itemCP.value = nv; if itemCP.callback then itemCP.callback(nv) end end); clickFrame = false; clickConsumed = true end
                                        end

