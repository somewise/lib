    function UILib:SetMenuSize(s)         self.w=s.x or self.w; self.h=s.y or self.h end
    function UILib:SetMenuKey(k)
        local key=tostring(k):lower()
        if self._inputs[key] then
            self._menu_key=key
            self:Notification('Menu key set to '..key:upper(),3)
        else
            self:Notification('Invalid key: '..key,3)
        end
    end
    function UILib:CenterMenu()
        local ss=self:_GetScreenSize(); local ms=self:GetMenuSize()
        self:SetMenuPosition(Vector2.new(ss.x/2-ms.x/2,ss.y/2-ms.y/2))
    end
    function UILib:Notification(text,time)
        local txt=tostring(text)
        self._notifications = self._notifications or {}
        for _,n in ipairs(self._notifications) do
            if n.text==txt then
                if os.clock() - n._spawned_at < 1 then return end
                n._spawned_at=os.clock(); n.time=time; return
            end
        end
        if #self._notifications>=5 then
            table.remove(self._notifications,1)
        end
        table.insert(self._notifications,{text=txt,time=time or 3,_id=self._notifications_spawned,_spawned_at=os.clock()})
        self._notifications_spawned=self._notifications_spawned+1
    end
    function UILib:Tab(tabName)
        self._tree = self._tree or {}
        self._tree[tabName]={_items={}, _searchQuery=""}
        self._tab_order = self._tab_order or {}
        table.insert(self._tab_order,tabName)
        if not self._open_tab then self._open_tab=tabName; self._tab_fade=1 end
        return{Section=function(_,sn) return self:_Section(tabName,sn) end}
    end
    function UILib:RegisterActivity(a)
