                                        else self._slider_drag = nil end
                                        local clicked = mouseHeld and self._slider_drag == siid
                                        
                                        local bPressKey = siid..'_bp'
                                        self._toggle_anim[bPressKey] = lerp(self._toggle_anim[bPressKey] or 0, clicked and 1 or 0, _dlp(0.45))
                                        local bPress = self._toggle_anim[bPressKey]
                                        local bInset = math.floor(bPress * 2 + 0.5)
                                        local bOa  = bO + Vector2.new(bInset, bInset)
                                        local bSza = bSz - Vector2.new(bInset*2, bInset*2)
                                        local bBg  = lerpC(hover and lerpC(T.surface0, T.accent, 0.08) or T.surface0, T.accent, bPress * 0.85)

                                        self:_Draw('rect', T.shadow, 6, (1-bPress)*0.10*itemOp, bO+Vector2.new(1,2), bSz, true, 6)
                                        self:_Draw('rect', bBg, 7, itemOp, bOa, bSza, true, 6)
                                        self:_Draw('rect', clicked and T.accent or T.border1, 8, itemOp, bOa, bSza, false, 6)

