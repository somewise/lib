                        if self._unloading_sequence and self._unload_phase == 'sections' then
                            cardFade = cardFade * (self._unload_section_alpha or 1)
                        end

                        if isSecVisible and cardFade > 0.001 then
                            self:_Draw('rect', T.shadow, 2, 0.10*cardFade*winOp, Vector2.new(sPos.x+2,rectTop+3), Vector2.new(secW,rectH), true, useCR)
                            self:_Draw('rect', T.surface0, 3, cardFade*winOp, Vector2.new(sPos.x,rectTop), Vector2.new(secW,rectH), true, useCR)
                            self:_Draw('rect', T.border1, 4, cardFade*winOp, Vector2.new(sPos.x,rectTop), Vector2.new(secW,rectH), false, useCR)
                        end

                        local titleY   = sPos.y - (sTsz.y/2)*secAnim - 7
                        local titleBot = titleY + sTsz.y
                        local FADE_ZONE = 12

                        local titleFade = secAnim * cardAlpha
                        local titleVisible = (titleBot > secTopY) and (titleY < tabBotY)

                        if titleVisible then
                            local tDistTop = titleY - secTopY
                            local tDistBot = tabBotY - titleBot
                            if tDistTop < FADE_ZONE then titleFade = math.min(titleFade, math.max(0, tDistTop / FADE_ZONE)) end
                            if tDistBot < FADE_ZONE then titleFade = math.min(titleFade, math.max(0, tDistBot / FADE_ZONE)) end
                            if tDistTop < 0 or tDistBot < 0 then titleFade = 0 end
                            if self._unloading_sequence and self._unload_phase == 'sections' then titleFade = titleFade * (self._unload_section_alpha or 1) end
                        else titleFade = 0 end

                        if titleFade > 0.001 then
                            self:_Draw('text', T.subtext, 6, winOp*titleFade, Vector2.new(sPos.x+PAD, titleY), secName, false)
                        end

                        local secContent = tabContent3._items and tabContent3._items[secName] or {_items={}}
                        local sH = (PAD + sTsz.y/2) * secAnim

                        for siIter, sItem in ipairs(secContent._items or {}) do
                            local animKey = "s_anim_" .. sItem._id
                            local sAnim   = self._toggle_anim[animKey] or 0

                            if sAnim > 0.001 then
                                local iH = GetItemHeight(self, sItem)
                                local current_iH = iH * sAnim

                                local siOrigBase = Vector2.new(sPos.x+PAD, sPos.y+sH)
                                local iType = sItem.type_; local iVal = sItem.value; local iCb = sItem.callback
                                local ak = tabName..secName..tostring(siIter)

                                local itemTop = siOrigBase.y
                                local itemBot = siOrigBase.y + current_iH - (PAD * sAnim)

                                local itemVisible = isSecVisible and (itemBot >= secTopY) and (itemTop <= tabBotY)
                                local edgeFade = sAnim * cardAlpha

                                if itemVisible then
                                    local iDistTop = itemTop - secTopY
                                    local iDistBot = tabBotY - itemBot
                                    if iDistTop < FADE_ZONE then edgeFade = math.min(edgeFade, math.max(0, iDistTop / FADE_ZONE)) end
                                    if iDistBot < FADE_ZONE then edgeFade = math.min(edgeFade, math.max(0, iDistBot / FADE_ZONE)) end
                                    if iDistTop < 0 or iDistBot < 0 then edgeFade = 0 end
                                    if self._unloading_sequence and self._unload_phase == 'sections' then edgeFade = edgeFade * (self._unload_section_alpha or 1) end
                                end

                                if edgeFade <= 0.001 then itemVisible = false end

                                local siid   = sItem._id
                                local interactable = itemVisible and (edgeFade > 0.4)

                                if not itemVisible then
                                    self._item_vis[siid] = false
                                else
                                    self._item_vis[siid] = true
                                    local siOrig   = siOrigBase
                                    local canClick = interactable and clickFrame and not clickConsumed
                                    local itemOp   = winOp * edgeFade * secAnim

                                    -- ─────────────────────────────────────────────
                                    -- TOGGLE
                                    -- ─────────────────────────────────────────────
                                    if iType == 'toggle' then
                                        local tgt = iVal and 1 or 0
                                        local cur = lerp(self._toggle_anim[ak] or tgt, tgt, _dlp(0.10))
                                        self._toggle_anim[ak] = cur
                                        local SW = 34; local SH2 = self._font_size + 2
                                        local itemKB = sItem.keybind; local itemCP = sItem.colorpicker
                                        local rightReserve = 0

                                        if itemKB then
                                            rightReserve = KB_W + PAD
                                            local kbName = (itemKB.value or '?'):upper()
                                            local kbTxt  = itemKB._listening and '...' or kbName
                                            local kbFont = 12
                                            while kbFont > 7 and self:_GetTextBounds(kbTxt, nil, kbFont).x > KB_W - 6 do kbFont = kbFont - 1 end
                                            local kbOrig = Vector2.new(sPos.x+secW-KB_W-PAD, siOrig.y+(SH2-self._font_size)/2)
                                            local kbSz   = Vector2.new(KB_W, self._font_size+2)
                                            local hover  = not mouseBlocked and self:_IsMouseWithinBounds(kbOrig, kbSz)
                                            local kbBg   = hover and lerpC(T.surface1, T.accent, 0.2) or T.surface1
                                            if itemKB.value and not itemKB._listening then
                                                if self:_IsKeyPressed(itemKB.value) then
                                                    if not sItem.value then self:Notification('Enable '..sItem.label..' first', 3)
                                                    else local nv = not sItem.value; sItem.value = nv; if iCb then iCb(nv) end end
                                                end
                                            end
                                            self:_Draw('rect', T.shadow, 6, 0.10*itemOp, kbOrig+Vector2.new(1,2), kbSz, true, 6)
                                            self:_Draw('rect', kbBg, 7, itemOp, kbOrig, kbSz, true, 6)
                                            self:_Draw('rect', itemKB._listening and T.accent or T.border1, 8, itemOp, kbOrig, kbSz, false, 6)

                                            local kbTxtColor = (hover or itemKB._listening) and T.text or T.subtext
                                            self:_Draw('text', kbTxtColor, 8, itemOp, kbOrig+Vector2.new(KB_W/2,kbSz.y/2), kbTxt, false, 'center', kbFont)

                                            if hover and canClick then itemKB._listening = true; itemKB._listening_start = os.clock(); clickFrame = false; clickConsumed = true end
                                            if itemKB._listening then
                                                local elapsed = os.clock() - itemKB._listening_start
                                                if elapsed > 6 then
                                                    itemKB._listening = false
                                                elseif elapsed > 0.15 then
                                                    for kn, k in pairs(self._inputs or {}) do
                                                        if self:_IsKeyPressed(kn) then
                                                            if kn == 'm1' then itemKB._listening = false
                                                            else
                                                                local nv = kn ~= 'backspace' and kn
                                                                if nv then
                                                                    for _, ref in ipairs(self._config_refs or {}) do
                                                                        local other = ref.item
                                                                        if other ~= sItem and other.keybind and other.keybind.value == nv then
                                                                            self:Notification('Conflict: '..nv:upper()..' used by '..other.label, 4)
                                                                        end
                                                                    end
                                                                end
                                                                if itemKB.callback and self._inputs[nv] then itemKB.callback(k.id) end
                                                                itemKB.value = nv; itemKB._listening = false
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        elseif itemCP then
                                            local cpSzEl = Vector2.new(24, 14)
                                            local cpOEl  = siOrig + Vector2.new(secW - PAD*2 - cpSzEl.x, (SH2 - cpSzEl.y)/2)
                                            rightReserve = cpSzEl.x + PAD*2
                                            local hover  = not mouseBlocked and self:_IsMouseWithinBounds(cpOEl, cpSzEl)

                                            self:_Draw('rect', T.border1, 7, itemOp, cpOEl, cpSzEl, true, 4)
                                            self:_Draw('rect', itemCP.value, 8, itemOp, cpOEl+Vector2.new(1,1), cpSzEl-Vector2.new(2,2), true, 4)

                                            if hover and canClick then self:_SpawnColorpicker(nil, itemCP.label, itemCP.value, function(nv) itemCP.value = nv; if itemCP.callback then itemCP.callback(nv) end end); clickFrame = false; clickConsumed = true end
                                        end

                                        local labelColor = sItem.unsafe and T.unsafe or (iVal and T.text or T.subtext)
                                        if not itemCP or not itemCP.overwrite then
                                            local hover = not mouseBlocked and self:_IsMouseWithinBounds(siOrig, Vector2.new(SW, SH2))
                                            if hover and canClick then local nv = not iVal; sItem.value = nv; if iCb then iCb(nv) end; clickFrame = false; clickConsumed = true end
                                            local trkC = lerpC(T.surface1, T.accent, cur)
                                            self:_Draw('rect', trkC, 7, itemOp, siOrig, Vector2.new(SW, SH2), true, SH2/2)
                                            self:_Draw('rect', lerpC(T.border1, T.accent, cur), 8, itemOp, siOrig, Vector2.new(SW, SH2), false, SH2/2)
                                            local kr = (SH2/2)-1; local kx = siOrig.x + kr + 1 + (SW - SH2) * cur; local ky = siOrig.y + SH2/2
                                            self:_Draw('circle', T.shadow, 8, 0.15*itemOp, Vector2.new(kx, ky+1), kr, true)
                                            self:_Draw('circle', T.surface0, 9, itemOp, Vector2.new(kx, ky), kr, true)
                                        else labelColor = T.text end

                                        local lblStr = sItem.label; local truncated = false
                                        local maxLblW = secW - SW - PAD*2 - rightReserve - (sItem.isNew and 36 or 0)
                                        while #lblStr > 1 and self:_GetTextBounds(lblStr).x > maxLblW do lblStr = lblStr:sub(1, -2); truncated = true end
                                        if truncated then lblStr = lblStr:sub(1, -2)..'..' end
                                        local actualLblSz = self:_GetTextBounds(lblStr)
                                        local lblPos = siOrig + Vector2.new(SW + PAD, (SH2 - self._font_size)/2)
                                        self:_Draw('text', labelColor, 7, itemOp, lblPos, lblStr, false)

                                        if interactable and truncated and not mouseBlocked and self:_IsMouseWithinBounds(lblPos, actualLblSz) then
                                            self._frame_tooltip = {key=siid, text=sItem.label}
                                        end

                                        if sItem.isNew then
                                            local newTagPos = lblPos + Vector2.new(actualLblSz.x + 8, -2)
                                            self:_Draw('rect', T.accent, 8, itemOp, newTagPos, Vector2.new(28, 14), true, 4)
                                            self:_Draw('text', T.surface0, 9, itemOp, newTagPos+Vector2.new(14, 7), 'NEW', false, 'center', 9)
                                        end

                                    -- ─────────────────────────────────────────────
                                    -- SLIDER
                                    -- ─────────────────────────────────────────────
                                    elseif iType == 'slider' then
                                        local sMin  = sItem.min or 0
                                        local sMax  = sItem.max or 100
                                        local sStep = sItem.step or 1

                                        local lsz   = self:_GetTextBounds(sItem.label)
                                        local btnW  = self._font_size
                                        local trackX = siOrig.x + btnW + PAD
                                        local trackW = secW - PAD*2 - btnW*2 - PAD*2
                                        local slO   = Vector2.new(trackX, siOrig.y + lsz.y + PAD)
                                        local slSz  = Vector2.new(trackW, 6)
                                        local slLbl = sItem.label; local slTrunc = false
                                        local maxLblW = secW - PAD*2 - (sItem.isNew and 36 or 0)
                                        while #slLbl > 1 and self:_GetTextBounds(slLbl).x > maxLblW do slLbl = slLbl:sub(1, -2); slTrunc = true end
                                        if slTrunc then slLbl = slLbl:sub(1, -2)..'..' end
                                        local actualLblSz = self:_GetTextBounds(slLbl)

                                        self:_Draw('text', T.subtext, 7, itemOp, siOrig, slLbl, false)

                                        if interactable and slTrunc and not mouseBlocked and self:_IsMouseWithinBounds(siOrig, actualLblSz) then
                                            self._frame_tooltip = {key=siid, text=sItem.label}
                                        end

                                        if sItem.isNew then
                                            local newTagPos = siOrig + Vector2.new(actualLblSz.x + 8, 0)
                                            self:_Draw('rect', T.accent, 8, itemOp, newTagPos, Vector2.new(28, 14), true, 4)
                                            self:_Draw('text', T.surface0, 9, itemOp, newTagPos+Vector2.new(14, 7), 'NEW', false, 'center', 9)
                                        end

                                        local nv = iVal or sMin

                                        local sliderHitPos = slO - Vector2.new(btnW + PAD, slSz.y + PAD)
                                        local sliderHitSz  = Vector2.new(trackW + (btnW + PAD) * 2, iH)
                                        local hover = not mouseBlocked and self:_IsMouseWithinBounds(sliderHitPos, sliderHitSz)

                                        if hover and ctxFrame and interactable then
                                            nv = sItem.default ~= nil and sItem.default or sMin
                                            sItem.value = nv; if iCb then iCb(nv) end
                                            self:Notification('Reset to default', 2)
                                            ctxFrame = false
                                        end

                                        local trackHover = not mouseBlocked and self:_IsMouseWithinBounds(slO - Vector2.new(0, 6), slSz + Vector2.new(0, 12))

                                        if mouseHeld then
                                            if interactable and (trackHover or self._slider_drag == siid) and clickFrame and self._slider_drag ~= siid then
                                                self._slider_drag = siid; clickFrame = false; clickConsumed = true
                                            end
                                            if self._slider_drag == siid then
                                                local pct = clamp((self:_GetMousePos().x - slO.x) / slSz.x, 0, 1)
                                                nv = sMin + (sMax - sMin) * pct
                                                nv = math.floor((nv/sStep) + 0.5) * sStep
                                                nv = clamp(nv, sMin, sMax)
                                            end
                                        else
                                            self._slider_drag = nil
                                        end

                                        local decCX  = siOrig.x + btnW/2; local incCX = trackX + trackW + PAD + btnW/2
                                        local btnCY  = slO.y + slSz.y/2
                                        local decHit = Vector2.new(siOrig.x, btnCY - btnW/2); local incHit = Vector2.new(trackX + trackW + PAD, btnCY - btnW/2)
                                        local hitSz  = Vector2.new(btnW, btnW)

                                        local decHov = not mouseBlocked and self:_IsMouseWithinBounds(decHit, hitSz)
                                        local incHov = not mouseBlocked and self:_IsMouseWithinBounds(incHit, hitSz)

                                        self:_Draw('text', decHov and T.text or T.subtext, 7, itemOp, Vector2.new(decCX, btnCY), '-', false, 'center')
                                        self:_Draw('text', incHov and T.text or T.subtext, 7, itemOp, Vector2.new(incCX, btnCY), '+', false, 'center')

                                        if canClick and not mouseBlocked then
                                            if decHov then nv = clamp(nv - sStep, sMin, sMax); clickFrame = false; clickConsumed = true
                                            elseif incHov then nv = clamp(nv + sStep, sMin, sMax); clickFrame = false; clickConsumed = true end
                                        end

                                        if nv ~= iVal then sItem.value = nv; if iCb then iCb(nv) end end

                                        local fp = clamp((nv - sMin)/(math.max(0.01, sMax - sMin)), 0, 1)
                                        local sak = siid..'_dv'
                                        self._slider_disp[sak] = nv

                                        local isDragging = (self._slider_drag == siid)
                                        local trackBg = (trackHover or isDragging) and lerpC(T.surface1, T.accent, 0.12) or T.surface1
                                        self:_Draw('rect', trackBg, 7, itemOp, slO, slSz, true, 3)
                                        self:_Draw('rect', (trackHover or isDragging) and T.border0 or T.border1, 8, itemOp, slO, slSz, false, 3)
                                        local fillW = math.max(0, slSz.x * fp - 2)
                                        self:_Draw('rect', T.accent, 9, itemOp, slO+Vector2.new(1,1), Vector2.new(fillW, slSz.y-2), true, 3)
                                        local thumbX = slO.x + slSz.x * fp; local thumbY = slO.y + slSz.y/2
                                        local thumbR = isDragging and 7 or 5
                                        self:_Draw('circle', T.surface0, 10, itemOp, Vector2.new(thumbX, thumbY), thumbR, true)
                                        self:_Draw('circle', T.accent, 11, itemOp, Vector2.new(thumbX, thumbY), thumbR, false)

                                        local dv = fmtNum(nv)..sItem.suffix
                                        self:_Draw('text', T.text, 15, itemOp, Vector2.new(thumbX, thumbY+thumbR+6), dv, false, 'center', 11)

                                    -- ─────────────────────────────────────────────
                                    -- DROPDOWN
                                    -- ─────────────────────────────────────────────
                                    elseif iType == 'dropdown' then
                                        local lsz = self:_GetTextBounds(sItem.label)
                                        local dO  = Vector2.new(siOrig.x, siOrig.y + lsz.y + PAD)
                                        local dSz = Vector2.new(secW - PAD*2, lsz.y + PAD)
                                        local hover = not mouseBlocked and self:_IsMouseWithinBounds(dO, dSz)
                                        local isThisDropdownOpen = self._active_dropdown and self._active_dropdown_owner == siid
                                        
                                        if isThisDropdownOpen then
                                            self._active_dropdown.position = Vector2.new(dO.x, dO.y + dSz.y)
                                            self._active_dropdown._srcH = dSz.y
                                        end

                                        if hover and canClick then
                                            if isThisDropdownOpen then self:_RemoveDropdown(); self._active_dropdown_owner = nil
                                            else self:_SpawnDropdown(Vector2.new(dO.x, dO.y + dSz.y), dSz.x, iVal, sItem.choices, sItem.multi, function(nv) sItem.value = nv; if iCb then iCb(nv) end end)
                                                self._active_dropdown._srcH = dSz.y
                                                self._active_dropdown_owner = siid end
                                            clickFrame = false; clickConsumed = true
                                        end
                                        
                                        local aak = siid..'_arw'
                                        self._dd_arrow_anim[aak] = lerp(self._dd_arrow_anim[aak] or 0, isThisDropdownOpen and 1 or 0, _dlp(0.35))
                                        local at = self._dd_arrow_anim[aak]
                                        
                                        -- [!] LEFT-TO-DOWN ARROW ANIMATION
                                        local ax = math.floor(dO.x + dSz.x - PAD - 4)
                                        local ay = math.floor(dO.y + dSz.y / 2)
                                        
                                        local p1 = Vector2.new(
                                            math.floor(lerp(ax + 2, ax - 3, at) + 0.5),
                                            math.floor(lerp(ay - 3, ay - 2, at) + 0.5)
                                        )
                                        local p2 = Vector2.new(
                                            math.floor(lerp(ax + 2, ax + 3, at) + 0.5),
                                            math.floor(lerp(ay + 3, ay - 2, at) + 0.5)
                                        )
                                        local p3 = Vector2.new(
                                            math.floor(lerp(ax - 3, ax, at) + 0.5),
                                            math.floor(lerp(ay, ay + 3, at) + 0.5)
                                        )
                                        
                                        local dBg = hover and lerpC(T.surface0, T.accent, 0.06) or T.surface0
                                        self:_Draw('rect', T.shadow, 6, 0.10*itemOp, dO+Vector2.new(1,2), dSz, true, 6)
                                        self:_Draw('rect', dBg, 7, itemOp, dO, dSz, true, 6)
                                        self:_Draw('rect', T.border1, 8, itemOp, dO, dSz, false, 6)

                                        self:_Draw('triangle', T.subtext, 8, itemOp, true, p1, p2, p3)

                                        local dv = type(iVal)=='table' and table.concat(iVal, ', ') or tostring(iVal or '')
                                        if self:_GetTextBounds(dv).x > dSz.x - PAD - 14 then dv = tostring(#(iVal or {}))..' item'..(#(iVal or {}) == 1 and '' or 's') end
                                        
                                        local interactColor = hover and T.text or T.subtext
                                        self:_Draw('text', interactColor, 8, itemOp, dO+Vector2.new(6, self:_GetTextBounds(dv).y/2 - 1), dv, false)

                                        local maxLblW = secW - PAD*2 - (sItem.isNew and 36 or 0)
                                        local ddLbl = sItem.label; local ddTrunc = false
                                        while #ddLbl > 1 and self:_GetTextBounds(ddLbl).x > maxLblW do ddLbl = ddLbl:sub(1, -2); ddTrunc = true end
                                        if ddTrunc then ddLbl = ddLbl:sub(1, -2)..'..' end
                                        local actualLblSz = self:_GetTextBounds(ddLbl)

                                        self:_Draw('text', T.subtext, 7, itemOp, siOrig+Vector2.new(PAD, 0), ddLbl, false)

                                        if interactable and ddTrunc and not mouseBlocked and self:_IsMouseWithinBounds(siOrig+Vector2.new(PAD, 0), actualLblSz) then
                                            self._frame_tooltip = {key=siid..'dd', text=sItem.label}
                                        end

