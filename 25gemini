local _textBoundsCache={}
local function cachedTextBounds(lib,text,fontFace,fontSize)
    text = text or ""
    local key=tostring(fontFace or lib._font_face)..':'..tostring(fontSize or lib._font_size)..':'..text
    local cached=_textBoundsCache[key]
    if cached then return cached end
    local result=lib:_GetTextBounds(text,fontFace,fontSize)
    _textBoundsCache[key]=result
    return result
end

local function dlp(base,dt) return 1-(1-base)^(dt*60) end

local function rgbToHsv(r,g,b)
    local max,min=math.max(r,g,b),math.min(r,g,b)
    local d=max-min
    local h,s,v=0,0,max
    if max>0 then s=d/max end
    if d>0 then
        if max==r then h=(g-b)/d; if g<b then h=h+6 end
        elseif max==g then h=(b-r)/d+2
        elseif max==b then h=(r-g)/d+4 end
        h=h/6
    end
    return h,s,v
end

