loadstring(game:HttpGet('https://raw.githubusercontent.com/somewise/lib/refs/heads/main/lib'))()

_G.AutoGreen    = false
_G.AutoGreenKey = 't'
_G.ReleaseDelay = 0.52
_G.AG_Firing    = false

print("------------------------------------------")
print("NBA Champions Basketball | Auto Green")
print("dm @prodordie on discord for help/ideas")
print("------------------------------------------")

UILib:SetMenuTitle('@prodordie')
UILib:SetMenuSize(Vector2.new(420, 480))
UILib:CenterMenu()

local nbaTab     = UILib:Tab('NBA')
local nbaSection = nbaTab:Section('Auto Shoot')

local agToggle = nbaSection:Toggle('Auto Green', false, function(v)
    _G.AutoGreen = v
end)
agToggle:AddKeybind('t', 'Toggle', true, function(newKeyId)
    local name = UILib:_KeyIDToName(newKeyId)
    if name then _G.AutoGreenKey = name end
end)

nbaSection:Slider('Release Delay', 0.52, 0.01, 0.10, 1.00, 's', function(v)
    _G.ReleaseDelay = v
end)

local settingsTab, menuSection = UILib:CreateSettingsTab('Settings')
menuSection:Button('Unload', function()
    _G.AutoGreen = false
    UILib:Unload()
end)

UILib:Notification('@prodordie loaded', 6)
UILib:Notification('F5 to toggle menu', 8)

UILib:AutoLoadConfig()

local _prevKeyHeld = false

while not UILib._unloaded do
    UILib:Step()

    if _G.AutoGreen and not _G.AG_Firing then
        local keyHeld = UILib:_IsKeyHeld(_G.AutoGreenKey)
        if keyHeld and not _prevKeyHeld then
            _G.AG_Firing = true
            task.spawn(function()
                mouse1press()
                wait(_G.ReleaseDelay)
                mouse1release()
                _G.AG_Firing = false
            end)
        end
        _prevKeyHeld = keyHeld
    else
        _prevKeyHeld = false
    end

    task.wait()
end

UILib:_FullWipe()
setrobloxinput(true)
print("NBA Champions | Unloaded")
